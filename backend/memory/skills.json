{
  "en.wikipedia.org": {
    "open https://en.wikipedia.org/wiki/linkedin": [
      {
        "name": "goto",
        "args": {
          "url": "https://en.wikipedia.org/wiki/LinkedIn"
        }
      }
    ],
    "open https://en.wikipedia.org/wiki/linkedin in the current tab": [
      {
        "name": "search_page",
        "args": {
          "pattern": "History",
          "max_results": 5
        }
      }
    ],
    "open https://en.wikipedia.org/wiki/linkedin and note the final url after loading": [
      {
        "name": "note",
        "args": {
          "text": "Final URL after loading https://en.wikipedia.org/wiki/LinkedIn is https://en.wikipedia.org/wiki/LinkedIn"
        }
      }
    ],
    "open https://en.wikipedia.org/wiki/artificial_intelligence": [
      {
        "name": "goto",
        "args": {
          "url": "https://en.wikipedia.org/wiki/Artificial_intelligence"
        }
      }
    ],
    "click one link in the first paragraph and arrive at the new page": [
      {
        "name": "search_page",
        "args": {
          "pattern": "The general problem of simulating (or creating) intelligence has been broken down into subproblems",
          "max_results": 5
        }
      },
      {
        "name": "click_text",
        "args": {
          "text": "Reasoning"
        }
      }
    ],
    "open the wikipedia page for largest organisms": [
      {
        "name": "goto",
        "args": {
          "url": "https://en.wikipedia.org/wiki/Largest_organisms"
        }
      }
    ],
    "extract and report the largest living species on earth from the page content": [
      {
        "name": "note",
        "args": {
          "text": "Largest living species on Earth: blue whale (largest animal ever to exist, from Largest organisms Wikipedia page)"
        }
      }
    ],
    "search google for \"largest living reptile\" and open the wikipedia list of largest reptiles page from results": [
      {
        "name": "search",
        "args": {
          "query": "largest living reptile"
        }
      },
      {
        "name": "click_text",
        "args": {
          "text": "List of largest reptiles"
        }
      }
    ],
    "read visible text and any sections on living/extant reptiles to identify the largest alive today": [
      {
        "name": "search_page",
        "args": {
          "pattern": "largest living OR extant OR saltwater crocodile OR leatherback",
          "max_results": 10
        }
      },
      {
        "name": "search_page",
        "args": {
          "pattern": "saltwater crocodile|leatherback|extant|largest living",
          "max_results": 10
        }
      },
      {
        "name": "note",
        "args": {
          "text": "From List_of_largest_reptiles Wikipedia: Saltwater crocodile is the largest extant reptile, verified up to 6.32 m (20.7 ft), considered largest living. Table: Saltwater crocodile 400-1300kg, max 2000kg, 7m. Leatherback sea turtle largest extant turtle."
        }
      }
    ],
    "open wikipedia page for 'list of largest reptiles'": [
      {
        "name": "goto",
        "args": {
          "url": "https://en.wikipedia.org/wiki/List_of_largest_reptiles"
        }
      }
    ],
    "read the visible text and section on extant (living) species to identify the largest living reptile": [
      {
        "name": "search_page",
        "args": {
          "pattern": "extant OR \"largest living\" OR \"saltwater crocodile\" OR leatherback",
          "max_results": 10
        }
      },
      {
        "name": "search_page",
        "args": {
          "pattern": "extant|largest living|saltwater crocodile",
          "max_results": 10
        }
      }
    ],
    "read the section on extinct species to identify one of the largest extinct reptiles": [
      {
        "name": "search_page",
        "args": {
          "pattern": "extinct|prehistoric|largest extinct|mosasaur|dinosaur",
          "max_results": 10
        }
      },
      {
        "name": "search_page",
        "args": {
          "pattern": "Mosasaurs|mosasaur|Stupendemys|Archelon|Titanoboa",
          "max_results": 5
        }
      },
      {
        "name": "note",
        "args": {
          "text": "Largest extinct reptile: Mosasaurus / giant mosasaurs up to 17 m (56 ft) and 20 t (from section text on Mosasaurs)"
        }
      }
    ],
    "open https://en.wikipedia.org/wiki/list_of_academic_journals": [
      {
        "name": "goto",
        "args": {
          "url": "https://en.wikipedia.org/wiki/List_of_academic_journals"
        }
      }
    ],
    "open wikipedia page for ca: a cancer journal for clinicians": [
      {
        "name": "search",
        "args": {
          "query": "CA: A Cancer Journal for Clinicians Wikipedia"
        }
      },
      {
        "name": "click_text",
        "args": {
          "text": "CA (journal) Wikipedia"
        }
      }
    ],
    "extract and confirm the listed journal impact factor from the page content": [
      {
        "name": "search_page",
        "args": {
          "pattern": "Impact factor",
          "max_results": 5
        }
      }
    ],
    "navigate to https://en.wikipedia.org/wiki/largest_organisms": [
      {
        "name": "click_text",
        "args": {
          "text": "Largest organisms - Wikipedia"
        }
      }
    ],
    "from the results open the blue whale wikipedia page": [
      {
        "name": "goto",
        "args": {
          "url": "https://en.wikipedia.org/wiki/Blue_whale"
        }
      }
    ]
