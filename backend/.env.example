# LLM keys — Grok is used if XAI_API_KEY (or GROK_API_KEY) is set;
# otherwise the agent falls back to Claude via ANTHROPIC_API_KEY.

XAI_API_KEY=
# GROK_API_KEY=

ANTHROPIC_API_KEY=

# Optional. Defaults: grok-4 / grok-4-fast when a Grok key is set,
# claude-sonnet-5-5 / claude-haiku-5-5 when only Claude is set.
# AGENT_PLANNER_MODEL=
# AGENT_EXECUTOR_MODEL=
